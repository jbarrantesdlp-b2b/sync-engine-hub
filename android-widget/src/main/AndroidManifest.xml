<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com">
    
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:networkSecurityConfig="@xml/network_security_config">
        <receiver android:name="com.barrantes.widget.WidgetHourProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.barrantes.widget.ACTION_FORCE_SYNC" />
            </intent-filter>
            <meta-data 
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hour_info" />
        </receiver>
        
        <service android:name="com.barrantes.widget.SyncBackgroundService" android:exported="false" />
    </application>
</manifest>
